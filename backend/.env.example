# ──────────────────────────────────────────────
# BRICOLE Backend — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Database (SQLite by default — no setup needed)
DATABASE_URL="file:./dev.db"

# JWT Secret — CHANGE THIS in production!
JWT_SECRET="bricole-super-secret-key-change-me-in-production-2026"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5500"

# Stripe (use test keys — get them from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_PRICE_ID="price_REPLACE_ME"

# Admin default account (created on seed)
ADMIN_EMAIL="admin@bricole.dz"
ADMIN_PASSWORD="Admin1234!"
